        "!pip -q install pyfaidx biopython\n",
        "!apt-get -qq install -y gffread diamond-aligner > /dev/null 2>&1\n",
        "\n",
        "import re, os, subprocess, itertools, gzip, shutil, urllib.request\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import PathPatch, Rectangle, Patch\n",
        "from matplotlib.path import Path as MPath\n",
        "from pathlib import Path\n",
        "from pyfaidx import Fasta\n",
        "from Bio import SeqIO\n",
        "from Bio.Seq import Seq\n",
        "\n",
        "BASE = Path('/content')                       # uploaded files live here\n",
        "OUT = BASE / 'processed_v3'; OUT.mkdir(exist_ok=True)\n",
        "(OUT / 'pairs').mkdir(exist_ok=True)\n",
        "\n",
        "# ---------- species ----------\n",
        "SPECIES = ['Tcas', 'Tmad', 'Tfre', 'Tcon']    # first = reference (labels and colours come from it)\n",
        "REF = SPECIES[0]\n",
        "FILE_PREFIX = {'Tcas': 'Tcas', 'Tmad': 'Tmad', 'Tfre': 'Tfree', 'Tcon': 'Tcon'}   # file-name prefixes (note Tfree)\n",
        "NAMES = {'Tcas': 'T. castaneum', 'Tmad': 'T. madens', 'Tfre': 'T. freemani', 'Tcon': 'T. confusum'}\n",
        "PAIRS = list(itertools.combinations(SPECIES, 2))   # 6 pairs; A (top) is the earlier species in SPECIES\n",
        "\n",
        "# ---------- thresholds (all in one place) ----------\n",
        "MIN_LEN = {'Tcas': 4_000_000, 'Tfre': 4_000_000, 'Tcon': 4_000_000,\n",
        "           'Tmad': 4_000_000}          # per species; CHECK Tmad (scaffold-level) in the overview cell before trusting it\n",
        "MIN_PIDENT, MIN_COV = 40, 0.5          # per-hit filters (coverage = aligned length / shorter protein)\n",
        "AMBIG_RATIO = 0.95                     # drop a gene if its 2nd-best hit scores >= 95% of its best (paralogs)\n",
        "G_MAX, MIN_ANCHORS = 10, 5             # block finder: max gene gap, min anchors per block\n",
        "EVENT_MIN_ANCHORS = 15                 # only blocks this large are used to call breakpoints\n",
        "END_BP = 200_000                       # breakpoint within this distance of a sequence end -> unresolved\n",
        "GAP_PAD_BP, MIN_GAP_N = 50_000, 10     # breakpoint within 50 kb of an N-run (>=10 N) -> unresolved\n",
        "STRONG_MIN, MAX_GAP_GENES = 50, 2      # tier A: both flanking blocks >= 50 anchors and <= 2 genes between them\n",
        "WIN_PAD, MAX_LOCALIZED = 25_000, 200_000\n",
        "DRAW_MIN, GAP_BP, NOBLOCK_MIN = 10, 4_000_000, 3_000_000     # ribbon figure\n",
        "TRI_PAD = 500_000                      # triangulation: Tcas breakpoints within this distance are the same locus\n",
        "\n",
        "REUSE_DIAMOND = False                  # True = reuse existing DIAMOND tables (only if inputs and MIN_LEN are unchanged)\n",
        "SHOW_FIGS = True\n",
        "BAM = {}                               # optional read-support test, e.g. {'Tcas': '/content/tcas_hifi.bam', 'Tfre': '/content/tfre_hifi.bam'}\n",
        "USE_OLD_LG_LABELS = False              # icTriCast1.1: use chromosome attributes in its own GFF region records\n",
        "\n",
        "assert REF == SPECIES[0]"
      ]
