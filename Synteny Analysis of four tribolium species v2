        "def unique_best(h):\n",
        "    \"\"\"Best hit per query after pident/coverage filters; drop queries whose 2nd hit is nearly as good (paralogs, ties).\"\"\"\n",
        "    h = h.copy(); h['cov'] = h['length'] / h[['qlen', 'slen']].min(axis=1)\n",
        "    h = h[(h['pident'] >= MIN_PIDENT) & (h['cov'] >= MIN_COV)]\n",
