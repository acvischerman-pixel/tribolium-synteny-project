      "source": [
        "COLS = ['seqid','source','type','start','end','score','strand','phase','attributes']\n",
        "\n",
        "def read_annot(path):\n",
        "    return pd.read_csv(path, sep='\\t', comment='#', header=None, names=COLS, dtype={'seqid': str}, low_memory=False)\n",
        "\n",
        "def parse_attrs(s):\n",
        "    d = {}\n",
        "    for part in str(s).split(';'):\n",
        "        part = part.strip()\n",
        "        if not part: continue\n",
        "        if re.match(r'^\\w+\\s+\"', part): k, _, v = part.partition(' ')\n",
        "        elif '=' in part: k, v = part.split('=', 1)\n",
        "        else: k, _, v = part.partition(' ')\n",
        "        d[k.strip()] = v.strip().strip('\"')\n",
        "    return d\n",
        "\n",
        "def build_gene_table(a):\n",
        "    \"\"\"One row per protein-coding gene, longest-CDS transcript.\"\"\"\n",
        "    cds = a[a['type'] == 'CDS'].copy()\n",
        "    assert len(cds), 'no CDS rows found in this annotation'\n",
        "    is_gtf = 'gene_id \"' in str(cds['attributes'].iloc[0])\n",
        "    attrs = cds['attributes'].map(parse_attrs)\n",
        "    if is_gtf:\n",
        "        cds['gene'] = attrs.map(lambda d: d.get('gene_id')); cds['tx'] = attrs.map(lambda d: d.get('transcript_id'))\n",
        "    else:\n",
        "        tx2gene = {}\n",
        "        for s in a[a['type'].isin(['mRNA', 'transcript'])]['attributes']:\n",
        "            d = parse_attrs(s)\n",
        "            if 'ID' in d: tx2gene[d['ID']] = d.get('Parent', '').split(',')[0]\n",
        "        cds['tx'] = attrs.map(lambda d: d.get('Parent', '').split(',')[0]); cds['gene'] = cds['tx'].map(tx2gene)\n",
        "        cds['gene'] = cds['gene'].replace('', np.nan).fillna(cds['tx'])      # CDS attached straight to a gene: use the parent as the gene\n",
        "    cds = cds.dropna(subset=['gene', 'tx'])\n",
        "    cds['clen'] = cds['end'] - cds['start'] + 1\n",
        "    tx = cds.groupby(['gene', 'tx']).agg(seqid=('seqid', 'first'), strand=('strand', 'first'), cds_len=('clen', 'sum')).reset_index()\n",
        "    rep = tx.sort_values(['gene', 'cds_len'], ascending=[True, False]).drop_duplicates('gene')\n",
        "    span = cds.groupby('gene').agg(start=('start', 'min'), end=('end', 'max'))\n",
        "    return rep.merge(span, left_on='gene', right_index=True).rename(columns={'gene': 'orig_gene_id', 'tx': 'rep_transcript'})\n",
        "\n",
        "def find_gaps(fasta, seqs):\n",
        "    \"\"\"(start, end) of every run of >= MIN_GAP_N N's, per sequence.\"\"\"\n",
        "    fa = Fasta(str(fasta)); pat = re.compile('[Nn]{%d,}' % MIN_GAP_N)\n",
        "    return {c: [(m.start(), m.end()) for m in pat.finditer(str(fa[c]))] for c in seqs}\n",
        "\n",
        "def norm_lg(v):\n",
        "    return str(v).upper().replace('CHLG', '').replace('LG', '').strip()\n",
        "\n",
        "def lg_rank(lg):\n",
        "    \"\"\"Sort key for linkage-group names: X, 2..10, Y, anything else.\"\"\"\n",
        "    if lg == 'LGX': return (0, 0)\n",
        "    m = re.fullmatch(r'LG(\\d+)', lg)\n",
        "    if m: return (1, int(m.group(1)))\n",
        "    if lg in ('LGY', 'Y?'): return (2, 0)\n",
        "    return (3, 0)"
      ]
    },
