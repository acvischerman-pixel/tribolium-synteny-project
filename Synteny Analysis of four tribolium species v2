      "source": [
        "FA_EXT, AN_EXT = {'.fna', '.fa', '.fasta'}, {'.gff', '.gff3', '.gtf'}\n",
        "G = {}   # per-species genome data\n",
        "\n",
        "def load_genome(sp):\n",
        "    # Tcas input must be the matching icTriCast1.1 FASTA + GFF (GCF_031307605.1).\n",
        "    pre = FILE_PREFIX[sp]\n",
        "    fa = [p for p in BASE.iterdir() if p.is_file() and p.suffix.lower() in FA_EXT and p.name.startswith(pre)]\n",
        "    an = [p for p in BASE.iterdir() if p.is_file() and p.suffix.lower() in AN_EXT and p.name.startswith(pre)]\n",
        "    assert len(fa) == 1 and len(an) == 1, f'{sp}: FASTA {fa}, annotation {an}'\n",
        "    fa, an = fa[0], an[0]\n",
        "    annot = read_annot(an)\n",
        "    lens = {k: len(v) for k, v in Fasta(str(fa)).items()}\n",
        "    keep = sorted([c for c, l in lens.items() if l >= MIN_LEN[sp]], key=lambda c: -lens[c])\n",
        "    gaps = find_gaps(fa, keep)\n",
        "    g_all = build_gene_table(annot)\n",
        "    g = g_all[g_all['seqid'].isin(keep)].sort_values(['seqid', 'start']).reset_index(drop=True)\n",
        "    g['gene_id'] = [f'{sp}_{i+1:05d}' for i in range(len(g))]\n",
        "    g['order'] = g.groupby('seqid').cumcount()\n",
        "    g.insert(0, 'species', sp)\n",
        "    g.to_csv(OUT / f'{sp}_genes.tsv', sep='\\t', index=False)\n",
        "    # proteins of the representative transcripts, renamed to gene_id\n",
        "    raw = OUT / f'{sp}_all.faa'\n",
        "    subprocess.run(['gffread', str(an), '-g', str(fa), '-y', str(raw)], check=True)\n",
        "    gi = g.set_index('rep_transcript'); recs, stops = [], 0\n",
        "    for rec in SeqIO.parse(raw, 'fasta'):\n",
        "        if rec.id not in gi.index: continue\n",
        "        s = str(rec.seq).upper().rstrip('.*')\n",
        "        if '.' in s or '*' in s: stops += 1; continue\n",
        "        rec.id, rec.description, rec.seq = gi.loc[rec.id, 'gene_id'], '', Seq(s)\n",
        "        recs.append(rec)\n",
        "    SeqIO.write(recs, OUT / f'{sp}_proteins.faa', 'fasta')\n",
        "    print(f'{sp}: {fa.name} + {an.name} | {len(lens)} sequences, {len(keep)} >= {MIN_LEN[sp]/1e6:.1f} Mb | '\n",
        "          f'{len(g)}/{len(g_all)} genes on kept sequences, {len(recs)} proteins ({stops} skipped, internal stops)')\n",
        "    return dict(fasta=fa, annot=annot, lens=lens, keep=keep, gaps=gaps, table=g, n_genes_all=len(g_all),\n",
        "                pos=g.set_index(['seqid', 'order'])[['start', 'end']], orig=g.set_index('gene_id')['orig_gene_id'])\n",
        "\n",
        "for sp in SPECIES:\n",
        "    G[sp] = load_genome(sp)"
      ]
