        "def triangulate(pad=TRI_PAD):\n",
        "    rows = []\n",
        "    for sp in SPECIES[1:]:\n",
        "        for r in R[(REF, sp)]['cand'].itertuples():\n",
        "            rows.append(dict(a_chrom=r.a_chrom, lo=r.a_lo, hi=r.a_hi, sp=sp, tier=r.tier[0], kind=r.kind))\n",
        "    if not rows: return pd.DataFrame()\n",
        "    df = pd.DataFrame(rows).sort_values(['a_chrom', 'lo']).reset_index(drop=True)\n",
        "    cl, cur, cur_hi, cur_c = [], -1, -1, None\n",
        "    for r in df.itertuples():\n",
        "        if r.a_chrom != cur_c or r.lo > cur_hi + pad: cur += 1; cur_hi = r.hi; cur_c = r.a_chrom\n",
        "        else: cur_hi = max(cur_hi, r.hi)\n",
        "        cl.append(cur)\n",
        "    df['locus'] = cl; out = []\n",
        "    for l, g in df.groupby('locus'):\n",
        "        row = dict(Tcas_seq=LAB[REF][g.a_chrom.iloc[0]], start_Mb=round(g.lo.min() / 1e6, 2), end_Mb=round(g.hi.max() / 1e6, 2))\n",
        "        for sp in SPECIES[1:]:\n",
        "            t = g[g.sp == sp].tier\n",
        "            row[sp] = min(t) if len(t) else '-'\n",
        "        sup = [sp for sp in SPECIES[1:] if row[sp] in ('A', 'B')]; unres = [sp for sp in SPECIES[1:] if row[sp] == 'C']\n",
        "        row['kinds'] = ', '.join(sorted(set(g.kind)))\n",
        "        row['reading'] = ('found vs all three: difference sits in Tcas (or ancestral state differs in Tcas)' if len(sup) == len(SPECIES) - 1 else\n",
        "                          f'{sup[0]}-specific candidate' + (f' (unresolved in {\", \".join(unres)})' if unres else '') if len(sup) == 1 else\n",
        "                          f'supported vs {\", \".join(sup)}' + (f' (unresolved in {\", \".join(unres)})' if unres else '') if sup else 'unresolved only')\n",
        "        out.append(row)\n",
        "    return pd.DataFrame(out)\n",
        "\n",
        "tri = triangulate(); tri.to_csv(OUT / 'tcas_breakpoint_triangulation.tsv', sep='\\t', index=False)\n",
        "display(tri)"
      ]
