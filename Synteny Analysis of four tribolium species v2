        "rows = []\n",
        "for A, B in PAIRS:\n",
        "    c, inv, pr = R[(A, B)]['cand'], R[(A, B)]['inv'], P[(A, B)]\n",
        "    sup = c[~c.tier.str.startswith('C')]\n",
        "    rows.append(dict(pair=f'{A}-{B}', anchors=len(pr['rbh']), pct_in_blocks=round((pr['anchors'].block >= 0).mean() * 100, 1),\n",
        "                     candidate_breakpoints=len(c), tier_A=int((c.tier == 'A strong').sum()), tier_B=int((c.tier == 'B supported, weaker').sum()),\n",
        "                     unresolved_C=int(c.tier.str.startswith('C').sum()),\n",
        "                     supported_chrom_changes=int((sup.kind == 'chromosome change').sum()), supported_orientation_switches=int((sup.kind == 'orientation switch').sum()),\n",
        "                     inverted_segments=len(inv)))\n",
        "summary = pd.DataFrame(rows); summary.to_csv(OUT / 'pair_summary.tsv', sep='\\t', index=False); display(summary)\n",
        "\n",
        "allcand = pd.concat([R[k]['cand'].assign(pair=f'{k[0]}-{k[1]}') for k in PAIRS], ignore_index=True)\n",
        "allcand.to_csv(OUT / 'all_pairs_breakpoint_validation.tsv', sep='\\t', index=False)\n",
        "pd.concat([R[k]['ov'] for k in PAIRS], ignore_index=True).to_csv(OUT / 'all_pairs_sequence_overview.tsv', sep='\\t', index=False)\n",
        "\n",
        "# ---- sequences with >= 2 partners (fusion, split chromosome, neo-sex chromosome), per pair ----\n",
        "ovall = pd.concat([R[k]['ov'] for k in PAIRS], ignore_index=True)\n",
        "print('\\nSequences whose blocks map to >= 2 partner sequences (>= 5% each):')\n",
        "display(ovall[ovall.n_partners >= 2][['pair', 'seq', 'length_Mb', 'genes', 'anchors_in_blocks', 'partners']].reset_index(drop=True))\n",
        "\n",
        "# ---- X: where does the Tcas X end up in each other species? ----\n",
        "print('\\nSequences receiving genes from the Tcas X (LGX):')\n",
        "xrows = []\n",
        "for sp in SPECIES[1:]:\n",
        "    an = P[(REF, sp)]['anchors']; an = an[an.block >= 0]\n",
        "    xs = [c for c in G[REF]['keep'] if LGOF[REF][c] == 'LGX']\n",
        "    if not xs: print('  no Tcas sequence is labelled LGX: set X_SEQ / check the old-LG table'); break\n",
        "    xb = an[an.chrom_a.isin(xs)].chrom_b.value_counts(); totb = an.chrom_b.value_counts()\n",
        "    for c, n in xb.items(): xrows.append(dict(species=sp, seq=LAB[sp][c], anchors_from_Tcas_X=int(n), pct_of_that_seq=round(n / totb[c] * 100, 1)))\n",
        "display(pd.DataFrame(xrows))\n",
        "\n",
        "# ---- neo-sex check: one sequence combining X-derived and autosome-derived blocks (expected in Tcon) ----\n",
        "print('\\nSequences combining X-derived and autosomal partners (neo-sex candidates; expected for T. confusum):')\n",
        "nrows = []\n",
        "for sp in SPECIES[1:]:\n",
        "    an = P[(REF, sp)]['anchors']; an = an[an.block >= 0]\n",
        "    for c, grp in an.groupby('chrom_b'):\n",
        "        vc = grp.chrom_a.value_counts(); keep_ = vc[vc / vc.sum() >= 0.05].index\n",
        "        lgs = [LGOF[REF][k] for k in keep_]\n",
        "        if 'LGX' in lgs and any(l not in ('LGX', 'Y?', '?') for l in lgs):\n",
        "            nrows.append(dict(species=sp, seq=LAB[sp][c], partners=', '.join(f'{SHORT[REF][k]} {vc[k]/vc.sum()*100:.0f}%' for k in keep_)))\n",
        "display(pd.DataFrame(nrows) if nrows else 'none found')\n",
        "print('If Tcon shows none: the fusion may not be assembled in that file (scaffolds are split), which is an assembly property, not a biological finding.')"
      ]
