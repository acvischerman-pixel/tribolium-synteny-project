        "                reasons[key] = problem(B, cb, min(gi.start, gj.start), max(gi.end, gj.end))\n",
        "            bad = {k: v for k, v in reasons.items() if v}\n",
        "            rows.append(dict(a_seq=LAB[A][ca], a_chrom=ca, kind=kind, left=f'{SHORT[B][x.chrom_b]}({x.orientation})', right=f'{SHORT[B][y.chrom_b]}({y.orientation})',\n",
        "                             left_block=int(x.block), right_block=int(y.block), left_anchors=int(x.n_anchors), right_anchors=int(y.n_anchors),\n",
        "                             gap_genes_a=int(y.start_a - x.end_a - 1),\n",
        "                             status='supported' if not bad else 'unresolved: ' + '; '.join(f'{k} {v}' for k, v in bad.items())))\n",
        "    return pd.DataFrame(rows, columns=EVENT_COLS)\n",
        "\n",
        "# ---- candidate table: tiers, coordinates in both genomes, IGV regions, optional read test ----\n",
        "def junction_support(bam_path, chrom, lo, hi, flank=1000, step=1000, min_mapq=20, min_clip=500):\n",
        "    \"\"\"min_span = the LOWEST number of reads that align continuously across any point (point +/- flank) inside the interval;\n",
        "    a misjoin leaves a point that no read spans. clip = reads clipped inside the interval.\"\"\"\n",
        "    import pysam\n",
        "    lo, hi = int(lo), int(hi); starts, ends, clip = [], [], 0\n",
        "    with pysam.AlignmentFile(bam_path) as bam:\n",
        "        for r in bam.fetch(chrom, max(0, lo - 2 * flank), hi + 2 * flank):\n",
        "            if r.is_unmapped or r.is_secondary or r.mapping_quality < min_mapq: continue\n",
        "            starts.append(r.reference_start); ends.append(r.reference_end)\n",
        "            ct = r.cigartuples or []\n",
        "            left = bool(ct) and ct[0][0] in (4, 5) and ct[0][1] >= min_clip and lo <= r.reference_start <= hi\n",
        "            right = bool(ct) and ct[-1][0] in (4, 5) and ct[-1][1] >= min_clip and lo <= r.reference_end <= hi\n",
        "            if left or right: clip += 1\n",
        "    if not starts: return 0, 0\n",
        "    starts, ends = np.array(starts), np.array(ends)\n",
        "    depth = [int(((starts <= p - flank) & (ends >= p + flank)).sum()) for p in np.arange(lo, hi + 1, step)]\n",
        "    return int(min(depth)), clip\n",
        "\n",
        "def read_call(span, clip, min_span=3):\n",
        "    if span is None: return 'not tested'\n",
        "    if span >= min_span and clip <= max(2, 0.2 * span): return 'reads span'\n",
        "    if span == 0 and clip >= 2: return 'POSSIBLE MISJOIN'\n",
        "    return 'low coverage / unclear'\n",
        "\n",
        "def test_side(sp, chrom, lo, hi):\n",
        "    if BAM.get(sp) is None or lo is None or pd.isna(lo): return None, None, 'not tested'\n",
        "    if hi - lo > MAX_LOCALIZED: return None, None, f'interval too wide (>{MAX_LOCALIZED // 1000} kb)'\n",
        "    s, c = junction_support(BAM[sp], chrom, lo, hi)\n",
        "    return s, c, read_call(s, c)\n",
        "\n",
        "CAND_COLS = ['event', 'tier', 'kind', 'a_chrom', 'a_label', 'a_lo', 'a_hi', 'b_left_chrom', 'b_left_lo', 'b_left_hi', 'b_right_chrom', 'b_right_lo', 'b_right_hi',\n",
        "             'b_junction_lo', 'b_junction_hi', 'min_flank_anchors', 'gap_genes_a', 'status', 'igv_A', 'igv_B']\n",
        "\n",
        "def candidate_table(A, B, pr, events):\n",
        "    posA, posB, bmap = G[A]['pos'], G[B]['pos'], pr['blocks'].set_index('block')\n",
        "    giv = lambda pos, chrom, order: (int(pos.loc[(chrom, order), 'start']), int(pos.loc[(chrom, order), 'end']))\n",
        "    reg = lambda c, lo, hi: f'{c}:{max(1, int(lo) - WIN_PAD)}-{int(hi) + WIN_PAD}'\n",
        "    rows = []\n",
        "    for i, e in enumerate(events.itertuples()):\n",
        "        x, y = bmap.loc[e.left_block], bmap.loc[e.right_block]\n",
        "        p, q = giv(posA, x.chrom_a, x.end_a), giv(posA, x.chrom_a, y.start_a)\n",
        "        a_lo, a_hi = min(p + q), max(p + q)\n",
        "        bj = b_junction(x, y); (c1, i1, j1), (c2, i2, j2) = bj[0], bj[-1]\n",
        "        if len(bj) == 1:\n",
        "            bl, br = giv(posB, c1, i1), giv(posB, c1, j1); b_lo, b_hi = min(bl + br), max(bl + br)\n",
        "        else:\n",
        "            bl, br = giv(posB, c1, i1), giv(posB, c2, i2); b_lo, b_hi = None, None\n",
        "        mf = min(e.left_anchors, e.right_anchors)\n",
        "        tier = 'C unresolved' if e.status != 'supported' else ('A strong' if (mf >= STRONG_MIN and e.gap_genes_a <= MAX_GAP_GENES) else 'B supported, weaker')\n",
        "        igvB = reg(c1, b_lo, b_hi) if b_lo is not None else reg(c1, *bl) + ' | ' + reg(c2, *br)\n",
        "        rows.append(dict(event=i, tier=tier, kind=e.kind, a_chrom=x.chrom_a, a_label=e.a_seq, a_lo=a_lo, a_hi=a_hi,\n",
        "                         b_left_chrom=c1, b_left_lo=bl[0], b_left_hi=bl[1], b_right_chrom=c2, b_right_lo=br[0], b_right_hi=br[1],\n",
        "                         b_junction_lo=b_lo, b_junction_hi=b_hi, min_flank_anchors=mf, gap_genes_a=e.gap_genes_a, status=e.status,\n",
        "                         igv_A=reg(x.chrom_a, a_lo, a_hi), igv_B=igvB))\n",
        "    cand = pd.DataFrame(rows, columns=CAND_COLS)\n",
        "    res = [(test_side(A, r.a_chrom, r.a_lo, r.a_hi), test_side(B, r.b_left_chrom, r.b_junction_lo, r.b_junction_hi)) for r in cand.itertuples()]\n",
        "    for k, side in enumerate(('A', 'B')):\n",
        "        cand[f'{side}_span'] = [t[k][0] for t in res]; cand[f'{side}_clip'] = [t[k][1] for t in res]; cand[f'{side}_reads'] = [t[k][2] for t in res]\n",
        "    cand['verdict'] = np.where(cand.tier.str.startswith('C'), 'unresolved (assembly artifact not excluded)',\n",
        "                      np.where((cand.A_reads == 'reads span') & (cand.B_reads == 'reads span'), 'supported in both genomes',\n",
        "                      np.where(cand.A_reads.eq('POSSIBLE MISJOIN') | cand.B_reads.eq('POSSIBLE MISJOIN'), 'CHECK: possible misjoin', 'untested / incomplete')))\n",
        "    return cand.sort_values(['tier', 'min_flank_anchors'], ascending=[True, False]).reset_index(drop=True)\n",
        "\n",
        "# ---- inverted segments (B sequences flipped to their dominant orientation first) ----\n",
        "def flip_map(df):\n",
        "    if df.empty: return {}\n",
        "    w = df.groupby(['chrom_b', 'orientation']).n_anchors.sum().unstack(fill_value=0).reindex(columns=['+', '-'], fill_value=0)\n",
        "    return {c: bool(w.loc[c, '-'] > w.loc[c, '+']) for c in w.index}\n",
        "\n",
        "def eff_orient(df, flip):\n",
        "    return ['+' if (o == '+') != flip.get(cb, False) else '-' for o, cb in zip(df.orientation, df.chrom_b)]\n",
        "\n",
        "INV_COLS = ['a_label', 'b_label', 'n_blocks', 'n_anchors', 'genes_in_A', 'a_start_bp', 'a_end_bp', 'a_span_Mb']\n",
        "def inverted_segments(A, B, pr):\n",
        "    posA, bl = G[A]['pos'], pr['blocks']\n",
        "    big = bl[bl.n_anchors >= EVENT_MIN_ANCHORS].copy()\n",
        "    if big.empty: return pd.DataFrame(columns=INV_COLS)\n",
        "    big['eff'] = eff_orient(big, flip_map(big)); big = big.sort_values(['chrom_a', 'start_a']); rows = []\n",
        "    for ca, g in big.groupby('chrom_a'):\n",
        "        g = g.reset_index(drop=True)\n",
        "        g['run'] = ((g.eff != g.eff.shift()) | (g.chrom_b != g.chrom_b.shift())).cumsum()\n",
        "        for _, r in g.groupby('run'):\n",
        "            if r.eff.iloc[0] == '+': continue\n",
        "            s, e_ = int(r.start_a.min()), int(r.end_a.max())\n",
        "            a0, a1 = int(posA.loc[(ca, s), 'start']), int(posA.loc[(ca, e_), 'end'])\n",
        "            rows.append(dict(a_label=LAB[A][ca], b_label=LAB[B][r.chrom_b.iloc[0]], n_blocks=len(r), n_anchors=int(r.n_anchors.sum()),\n",
        "                             genes_in_A=e_ - s + 1, a_start_bp=a0, a_end_bp=a1, a_span_Mb=round((a1 - a0) / 1e6, 2)))\n",
        "    return pd.DataFrame(rows, columns=INV_COLS)\n",
        "\n",
        "def sequence_overview(A, B, pr):\n",
        "    m = pr['anchors']; m = m[m.block >= 0]; rows = []\n",
        "    for sp, other, own, partner in ((A, B, 'chrom_a', 'chrom_b'), (B, A, 'chrom_b', 'chrom_a')):\n",
        "        t = G[sp]['table']\n",
        "        for c in G[sp]['keep']:\n",
        "            n = int((t.seqid == c).sum()); mb = G[sp]['lens'][c] / 1e6\n",
        "            part = m[m[own] == c][partner].value_counts(); tot = int(part.sum())\n",
        "            pl = [(k, v / tot) for k, v in part.items() if tot and v / tot >= 0.05]\n",
        "            rows.append(dict(pair=f'{A}-{B}', species=sp, seq=LAB[sp][c], seqid=c, length_Mb=round(mb, 2), genes=n, genes_per_Mb=round(n / mb, 1),\n",
        "                             n_gaps=len(G[sp]['gaps'][c]), anchors_in_blocks=tot, n_partners=len(pl),\n",
        "                             partners=', '.join(f'{SHORT[other][k]} {f*100:.0f}%' for k, f in pl)))\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "R = {}   # R[(A, B)] = dict(events, cand, inv, ov)\n",
        "for A, B in PAIRS:\n",
        "    d = OUT / 'pairs' / f'{A}_{B}'; d.mkdir(exist_ok=True)\n",
        "    pr = P[(A, B)]\n",
        "    pr['blocks'].to_csv(d / 'blocks.tsv', sep='\\t', index=False)\n",
        "    events = call_events(A, B, pr); cand = candidate_table(A, B, pr, events); inv = inverted_segments(A, B, pr); ov = sequence_overview(A, B, pr)\n",
        "    events.to_csv(d / 'events.tsv', sep='\\t', index=False); cand.to_csv(d / 'breakpoint_validation.tsv', sep='\\t', index=False)\n",
        "    inv.to_csv(d / 'inverted_segments.tsv', sep='\\t', index=False); ov.to_csv(d / 'sequence_overview.tsv', sep='\\t', index=False)\n",
        "    R[(A, B)] = dict(events=events, cand=cand, inv=inv, ov=ov)\n",
        "    tc = cand.tier.value_counts()\n",
        "    print(f'{A}-{B}: {len(events)} candidate breakpoints | tier A {tc.get(\"A strong\", 0)}, B {tc.get(\"B supported, weaker\", 0)}, '\n",
        "          f'C (unresolved) {tc.get(\"C unresolved\", 0)} | {len(inv)} inverted segments')"
      ]
