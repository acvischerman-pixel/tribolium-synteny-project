        "            covered[r.chrom_a].append((a0, a1))\n",
        "            if flipB.get(r.chrom_b): b0, b1 = G[B]['lens'][r.chrom_b] - b1, G[B]['lens'][r.chrom_b] - b0\n",
        "            xa0, xa1 = a0 + offA[r.chrom_a], a1 + offA[r.chrom_a]; xb0, xb1 = b0 + offB[r.chrom_b], b1 + offB[r.chrom_b]\n",
        "            if inverted: xb0, xb1 = xb1, xb0\n",
