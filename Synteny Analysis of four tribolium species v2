        "def show_event(A, B, i, n=4):\n",
        "    e = R[(A, B)]['events'].iloc[i]; anch = P[(A, B)]['anchors']; print(e.to_string())\n",
        "    for bid in (e.left_block, e.right_block):\n",
        "        x = anch[anch.block == bid].sort_values('order_a'); x = pd.concat([x.head(n), x.tail(n)])\n",
        "        x['orig_a'], x['orig_b'] = x['gene_a'].map(G[A]['orig']), x['gene_b'].map(G[B]['orig'])\n",
        "        print(f'\\nblock {bid}: first/last {n} anchors'); display(x[['orig_a', 'order_a', 'orig_b', 'order_b', 'pident', 'bits_ab']])\n",
        "\n",
        "def inspect_sequence(A, B, bseq):\n",
        "    \"\"\"Is a small B sequence the missing half of an A chromosome (complementary) or a duplicate of a region (overlapping)?\"\"\"\n",
        "    pr = P[(A, B)]; rbh, anchors = pr['rbh'], pr['anchors']; tb = G[B]['table']\n",
        "    n = int((tb.seqid == bseq).sum()); mb = G[B]['lens'][bseq] / 1e6; gp = G[B]['gaps'].get(bseq, [])\n",
        "    print(f'{bseq} ({SHORT[B][bseq]}): {mb:.2f} Mb, {n} genes ({n / mb:.1f}/Mb), {len(gp)} N-gaps')\n",
        "    allr = rbh[rbh.chrom_b == bseq]\n",
        "    print(f'  unambiguous 1:1 anchors: {len(allr)} | in blocks: {int((anchors[anchors.chrom_b == bseq].block >= 0).sum())}')\n",
        "    print('  anchor partners (all RBH):', allr.chrom_a.map(SHORT[A]).value_counts().to_dict())\n",
        "    a_start = G[A]['table'].set_index('gene_id')['start']; b_start = tb.set_index('gene_id')['start']\n",
        "    an = anchors.copy(); an['a_bp'] = an.gene_a.map(a_start); an['b_bp'] = an.gene_b.map(b_start)\n",
        "    tot = an[(an.chrom_b == bseq) & (an.block >= 0)]\n",
        "    for ca in tot.chrom_a.unique():\n",
        "        mine = an[(an.chrom_b == bseq) & (an.chrom_a == ca) & (an.block >= 0)]; others = an[(an.chrom_a == ca) & (an.chrom_b != bseq) & (an.block >= 0)]\n",
        "        lo, hi = mine.a_bp.min(), mine.a_bp.max()\n",
        "        print(f'\\n  partner {SHORT[A][ca]} ({G[A][\"lens\"][ca] / 1e6:.2f} Mb): this sequence covers {lo / 1e6:.2f}-{hi / 1e6:.2f} Mb of it ({len(mine)} anchors)')\n",
        "        for cb, o in others.groupby('chrom_b'):\n",
        "            ovl = max(0, min(hi, o.a_bp.max()) - max(lo, o.a_bp.min())); frac = ovl / max(1, hi - lo); inside = int(((o.a_bp >= lo) & (o.a_bp <= hi)).sum())\n",
        "            print(f'    vs {SHORT[B][cb]} ({G[B][\"lens\"][cb] / 1e6:.2f} Mb): covers {o.a_bp.min() / 1e6:.2f}-{o.a_bp.max() / 1e6:.2f} Mb; overlap {frac * 100:.0f}% of this sequence\\'s span; {inside} of its anchors inside that span')\n",
        "    print('  reading: little overlap -> consistent with one chromosome split across sequences (check join evidence); heavy overlap -> duplication / collapsed repeat / misassembly.')\n",
        "\n",
        "def why_unanchored(A, B, bseq):\n",
        "    hb = pd.read_csv(DB / f'{B}_vs_{A}.tsv', sep='\\t', names=dcols); genes = G[B]['table'][G[B]['table'].seqid == bseq].gene_id\n",
        "    h = hb[hb.qseqid.isin(genes)].copy(); h['cov'] = h['length'] / h[['qlen', 'slen']].min(axis=1)\n",
        "    ok = h[(h.pident >= MIN_PIDENT) & (h['cov'] >= MIN_COV)].sort_values(['qseqid', 'bitscore'], ascending=[True, False]).drop_duplicates(['qseqid', 'sseqid'])\n",
        "    ok['rank'] = ok.groupby('qseqid').cumcount(); best = ok[ok['rank'] == 0].set_index('qseqid'); second = ok[ok['rank'] == 1].set_index('qseqid')['bitscore']\n",
        "    anchored, hit_genes, cat = set(P[(A, B)]['rbh'].gene_b), set(h.qseqid), {}\n",
        "    for g in genes:\n",
        "        if g in anchored: cat[g] = '1. anchored (unique reciprocal best hit)'\n",
        "        elif g not in hit_genes: cat[g] = '5. no DIAMOND hit in the other species'\n",
        "        elif g not in best.index: cat[g] = '4. hits fail identity/coverage filter'\n",
        "        elif second.get(g, 0) >= AMBIG_RATIO * best.loc[g, 'bitscore']: cat[g] = '2. ambiguous (multi-copy / paralogs)'\n",
        "        else: cat[g] = '3. unique hit, but not reciprocal'\n",
        "    return pd.Series(cat).value_counts().sort_index()\n",
        "\n",
